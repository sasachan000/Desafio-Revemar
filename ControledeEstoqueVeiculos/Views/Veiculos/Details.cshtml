@model ControledeEstoqueVeiculos.Models.Veiculo

@{
    ViewData["Title"] = "Detalhes do Veículo";
}

<h2>Detalhes do Veículo</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Marca</dd>

    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo</dd>

    <dt class="col-sm-3">Ano</dt>
    <dd class="col-sm-9">@Model.Ano</dd>

    <dt class="col-sm-3">Cor</dt>
    <dd class="col-sm-9">@Model.Cor</dd>

    <dt class="col-sm-3">Preço</dt>
    <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>

    <dt class="col-sm-3">Situação</dt>
    <dd class="col-sm-9">@Model.Situacao</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>