@model IEnumerable<ControledeEstoqueVeiculos.Models.Veiculo>

@{
    ViewData["Title"] = "Estoque de Veículos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Estoque de Veículos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Cadastrar Novo Veículo</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Marca)</th>
            <th>@Html.DisplayNameFor(model => model.Modelo)</th>
            <th>@Html.DisplayNameFor(model => model.Ano)</th>
            <th>@Html.DisplayNameFor(model => model.Cor)</th>
            <th>@Html.DisplayNameFor(model => model.Preco)</th>
            <th>@Html.DisplayNameFor(model => model.Tipo)</th>
            <th>@Html.DisplayNameFor(model => model.Situacao)</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Marca)</td>
            <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
            <td>@Html.DisplayFor(modelItem => item.Ano)</td>
            <td>@Html.DisplayFor(modelItem => item.Cor)</td>
            <td>@item.Preco.ToString("C")</td>
            <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
            <td>
                <span class="badge @(item.Situacao == "Disponível" ? "bg-success" : item.Situacao == "Vendido" ? "bg-danger" : "bg-warning text-dark")">
                    @item.Situacao
                </span>
            </td>
            <td class="text-center">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>